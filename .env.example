# ── Grab A Sip API — environment variables ───────────────────────
# Set these on the host (Render → Environment). Locally you can export them
# or use a .env loader; the app has safe placeholder defaults so it still
# boots without a real DB (JWKS is fetched lazily).

# ── Database: Supabase Postgres via the SESSION POOLER (IPv4) ─────
# Use the pooler host from Supabase → Project → Database → Connection pooling
# (NOT the direct db.<ref>.supabase.co host, which is IPv6-only and fails on
# Render). Username is like "postgres.<ref>".
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<ref>
SPRING_DATASOURCE_PASSWORD=<your db password>

# ── Admin token (legacy fallback for /api/admin/* alongside admin JWTs) ──
# Long random string; the web app holds the same value as ADMIN_API_TOKEN.
ADMIN_TOKEN=<long-random-string>

# ── CORS: comma-separated origins allowed to call this API ───────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://grab-a-sip.vercel.app

# ── Supabase project URL (BARE) — used to build the JWKS endpoint ─
# Must be https://<ref>.supabase.co  (no /rest/v1/, no trailing slash).
SUPABASE_URL=https://<ref>.supabase.co

# ── Server port (Render injects PORT automatically) ──────────────
# PORT=8080
